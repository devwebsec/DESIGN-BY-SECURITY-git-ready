# Бинарные — Git НЕ трогает line endings
*.skill  binary
*.zip    binary
*.gz     binary
*.png    binary
*.jpg    binary

# Текстовые — LF везде
*        text=auto eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.sha256 text eol=lf
